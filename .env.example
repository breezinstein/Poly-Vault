# Copy to .env and fill in. NEVER commit .env.

# Shared team access token (long random string), e.g. `openssl rand -hex 16`.
PV_TOKEN=change-me-to-a-long-random-string

# Optional per-artist tokens: "alice:tok-a,bob:tok-b". Each person then has an
# identity, so "Import to Unity" is delivered only to their editor. Without it
# everyone shares one identity and every Unity editor sees every queued import.
# PV_USERS=

# Token allowed to add/remove libraries from the UI. Defaults to PV_TOKEN.
# PV_ADMIN_TOKEN=

# Public URL of the deployment (needed behind a TLS proxy so the Settings panel
# and the same-origin check use the right address).
# PV_PUBLIC_ORIGIN=https://vault.example.com

# Bind address for the published port. 127.0.0.1 = behind a TLS proxy only.
# PV_BIND=0.0.0.0

# --- asset storage ---------------------------------------------------------
# Local directories mounted read-only. One folder per library.
# PV_ASSETS=/srv/assets
# PV_ASSETS_2=/srv/assets-2
# Colon-separated roots = the libraries the UI shows (name = folder name).
# PV_LIBRARIES=/assets:/libraries/Second Library
# Everything the "Add Library" button may reach.
# PV_LIBRARY_ROOTS=/assets:/libraries

# NFS export holding the library (Unity's Asset Store cache or any folder).
# Only needed when you uncomment the `nas_unity_assets` volume in
# docker-compose.yml; compose interpolates these into the volume definition.
# PV_NFS_ADDR=nas.example.internal
# PV_NFS_EXPORT=/export/unity-assets

# --- optional tuning -------------------------------------------------------
# Disable outbound Unity Asset Store lookups (privacy / air-gapped hosts).
# ASSETVAULT_NO_ENRICH=1
# Only auto-describe/tag assets under these paths ("" = every library).
# Default in compose: /assets (the store cache), because hand-curated folder
# names like "Meshes" match unrelated store products.
# PV_ENRICH_ROOTS=/assets
# Max age of a cached scan; fs.watch covers local edits in between.
# PV_SCAN_MAX_AGE_MS=300000
# Mutating requests per person per minute (0 = unlimited).
# PV_RATE_LIMIT_PER_MIN=240
# Hide the access token in the Settings panel (use with per-person tokens/SSO).
# PV_SHOW_TOKEN=0
# Package index: 0 disables previews/contents extraction from .unitypackage.
# PV_PACKAGE_INDEX=0
# Upper size for the accurate-contents pass.
# PV_PACKAGE_INDEX_MAX_MB=150
